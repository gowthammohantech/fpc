# Line endings.
#
# Everything in this repository is stored with LF, and Prettier is configured
# with its default `endOfLine: "lf"`. Without this file a Windows checkout with
# `core.autocrlf=true` rewrites every file to CRLF, which leaves `pnpm lint`
# failing on all ~170 source files locally while passing in CI on Linux.
#
# `eol=lf` overrides `core.autocrlf` per-repository, so the working tree matches
# what is committed on every platform and no developer has to change a global
# git setting.
* text=auto eol=lf

# Binaries git must never touch. The spreadsheets and the PDF are test fixtures
# whose bytes are read back by the seed and import suites, so any newline
# translation would corrupt them.
*.xlsx binary
*.xls  binary
*.pdf  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.eot  binary
