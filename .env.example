# ─────────────────────────────────────────────────────────────
# Finance Operations Platform — environment configuration
# Copy to .env and adjust. Every integration defaults to a local
# driver, so the platform runs end to end with zero credentials.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Comma-separated list of origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# ── Database ────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/fpc

# ── Auth ────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-access-secret-change-me-in-production-000000
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-in-production-00000
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ── Blob storage ────────────────────────────────────────────
# local | azure
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.data/blobs
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=fpc-documents

# ── Outbound email ──────────────────────────────────────────
# console | smtp | graph
MAIL_DRIVER=smtp
MAIL_FROM="Finance Ops <finance-ops@example.com>"
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ── Inbound invoice mailbox (Outlook / Microsoft Graph) ─────
# fixture | graph
MAIL_FETCH_DRIVER=fixture
MAIL_FIXTURE_DIR=fixtures/inbox
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_MAILBOX=invoice@example.com

# ── Document extraction (OCR / AI) ──────────────────────────
# stub | claude | azure-doc-intelligence
OCR_DRIVER=stub
OCR_REVIEW_THRESHOLD=0.85
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
AZURE_DOC_INTEL_ENDPOINT=
AZURE_DOC_INTEL_KEY=

# ── Demo data ───────────────────────────────────────────────
# Seeds the demo dataset while the API boots, so a deployment with no shell
# comes up populated. Only runs when the database is empty — it never resets,
# so a restart of an already-seeded deployment does nothing.
SEED_ON_STARTUP=false

# ── Background jobs ─────────────────────────────────────────
JOBS_ENABLED=true
MAIL_POLL_CRON=*/1 * * * *
EXTRACTION_POLL_CRON=*/1 * * * *
NOTIFICATION_POLL_CRON=*/1 * * * *

# --- Outlook connector (delegated OAuth) -------------------------------------
# Encrypts stored third-party refresh tokens. Must decode to exactly 32 bytes:
#   openssl rand -base64 32
# Production refuses to start on the default below.
SECRET_ENCRYPTION_KEY=fpc-dev-secret-encryption-key!!!
# Where the OAuth callback returns the browser. Must be one of CORS_ORIGINS.
WEB_APP_URL=http://localhost:5173
# Off by default: the connect button explains itself rather than failing.
OUTLOOK_ENABLED=false
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
# A tenant GUID to restrict to one directory, or `common` for any account.
OUTLOOK_OAUTH_TENANT=common
# Register this exact value as a Web redirect URI on the Azure app.
OUTLOOK_REDIRECT_URI=http://localhost:4000/api/auth/outlook/callback
# Releases sync locks a crashed process left claimed. Never contacts Microsoft.
OUTLOOK_SWEEP_CRON=*/5 * * * *
