{
  "name": "fpc",
  "version": "1.0.0",
  "private": true,
  "description": "Finance Operations MVP \u2014 vendor invoice and payroll money-out workflow",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "build": "pnpm -r --filter @fpc/shared --filter @fpc/api-client build && pnpm -r --filter @fpc/server --filter @fpc/web build",
    "dev": "pnpm --parallel --filter @fpc/server --filter @fpc/web dev",
    "dev:server": "pnpm --filter @fpc/server dev",
    "dev:web": "pnpm --filter @fpc/web dev",
    "dev:mobile": "pnpm --filter @fpc/mobile start",
    "seed": "pnpm --filter @fpc/server seed",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . && prettier --check .",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "lint:fix": "eslint . --fix && prettier --write ."
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript-eslint": "^8.19.0"
  },
  "type": "module"
}
