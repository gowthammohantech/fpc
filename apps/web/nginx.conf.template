# Rendered by the nginx image's entrypoint (envsubst over /etc/nginx/templates)
# into /etc/nginx/conf.d/default.conf at container start. Only ${PORT},
# ${API_URL} and ${RESOLVER} are substituted — NGINX_ENVSUBST_FILTER in the
# Dockerfile keeps nginx's own $variables intact.

# Railway assigns every service a fresh private IPv6 address on each deploy, and
# nginx would otherwise resolve the upstream once at startup and keep talking to
# an address that no longer exists. ${RESOLVER} is Railway's internal DNS by
# default; a plain Docker network sets it to the embedded resolver instead.
resolver ${RESOLVER} ipv6=on valid=10s;

server {
    listen ${PORT};
    listen [::]:${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Invoice and statement uploads pass through here; the API accepts well
    # over nginx's 1m default.
    client_max_body_size 25m;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml font/woff2;

    # Platform health check. Deliberately local, so a sick API cannot take the
    # web service down with it.
    location = /healthz {
        access_log off;
        add_header Content-Type application/json;
        return 200 '{"status":"ok","service":"fpc-web"}';
    }

    # The SPA hardcodes a relative /api base URL so the browser sees a single
    # origin, which is what keeps the auth flow free of CORS and third-party
    # cookie rules. That contract is upheld here rather than in the client.
    location /api/ {
        # Assigning to a variable is what defers resolution to request time.
        set $upstream ${API_URL};
        proxy_pass $upstream$request_uri;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";

        # Exports and report downloads stream; give them room.
        proxy_connect_timeout 10s;
        proxy_send_timeout 120s;
        proxy_read_timeout 120s;
        proxy_buffering off;
    }

    # Content-hashed by Vite, so it can never go stale under a long max-age.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # Client-side routing: every unknown path is a react-router route, not a 404.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # A cached index.html would keep serving references to deleted asset bundles
    # after a deploy.
    location = /index.html {
        add_header Cache-Control "no-cache, must-revalidate";
    }
}
